{
    "name": "eryndrix/doctrine",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.4",
        "symfony/cache": "^7.3",
        "symfony/mercure": "^0.7.2",
        "symfony/var-exporter": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Eryndrix\\Doctrine\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev",
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
